{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "${sourceDir}/third_party/vcpkg/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "VCPKG_MANIFEST_MODE": "ON"
      }
    },
    {
      "name": "debug",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "STORAGE_ENABLE_SANITIZERS": "OFF" }
    },
    {
      "name": "release",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "STORAGE_ENABLE_SANITIZERS": "OFF" }
    },
    {
      "name": "sanitized",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "STORAGE_ENABLE_SANITIZERS": "ON" }
    },
    {
      "name": "bench-release",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "STORAGE_ENABLE_SANITIZERS": "OFF", "STORAGE_BUILD_TESTS": "OFF" }
    }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "debug" },
    { "name": "release", "configurePreset": "release" },
    { "name": "sanitized", "configurePreset": "sanitized" },
    { "name": "bench-release", "configurePreset": "bench-release" }
  ],
  "testPresets": [
    { "name": "debug", "configurePreset": "debug", "output": { "outputOnFailure": true } },
    {
      "name": "sanitized",
      "configurePreset": "sanitized",
      "environment": { "ASAN_OPTIONS": "allow_user_poisoning=0" },
      "output": { "outputOnFailure": true }
    }
  ]
}
